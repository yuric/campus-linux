{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Campus Updater 1057",
  "version": "1.0.0",
  "identifier": "dev.projectcampus.disposable-updater-1057",
  "build": { "frontendDist": "../ui" },
  "app": {
    "windows": [],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; connect-src 'none'" }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Disposable updater fixture, card 1057",
    "icon": ["icons/32x32.png"],
    "resources": { "resources/inert-helper.txt": "inert-helper.txt" },
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"] },
      "appimage": { "bundleMediaFramework": false }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "public fixture key is injected into the Rust builder",
      "endpoints": ["http://127.0.0.1:17857/stable/linux.json"],
      "dangerousInsecureTransportProtocol": true,
      "requireSignedVersion": true,
      "allowDowngrades": false
    }
  }
}
