# Policy bootstrap image; no fictitious product build or runtime tests.
FROM ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-yaml ca-certificates git \
    && dpkg-query -W > /usr/local/share/campus-verification-packages.tsv \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
ENTRYPOINT ["python3", "-B", "scripts/verify_repository.py"]
