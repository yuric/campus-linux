# Normalise line endings on commit. Without this a Windows contributor's editor
# can rewrite an entire file to CRLF and produce a diff with no real changes in it.
* text=auto eol=lf

# Windows-native tooling expects CRLF and breaks without it.
*.bat        text eol=crlf
*.cmd        text eol=crlf
*.ps1        text eol=crlf
*.sln        text eol=crlf
*.vcxproj    text eol=crlf

# Shell scripts must stay LF or they fail to execute.
*.sh         text eol=lf

# Binary: never diffed, never line-ending-converted.
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.icns       binary
*.pdf        binary
*.zip        binary
*.gz         binary
*.dmg        binary
*.woff       binary
*.woff2      binary
*.ttf        binary

# Generated: collapse in review, and keep out of language statistics.
docs/api/openapi.yaml   linguist-generated=true -diff
package-lock.json       linguist-generated=true -diff
