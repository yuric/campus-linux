{"argv": ["/opt/homebrew/Cellar/lima/2.2.1/bin/limactl", "--tty=false", "shell", "--workdir=/", "campus-linux-d5-noble-arm64", "--", "/usr/bin/sudo", "-n", "/usr/bin/env", "-i", "PATH=/usr/sbin:/usr/bin:/sbin:/bin", "/usr/bin/python3", "-I", "-S", "-B", "-c", "\"\"\"INACTIVE fixed owned-evidence export. No shell, writes, arbitrary paths or secrets.\n\nstdin {\"name\": one exact key below}; stdout raw bytes <=128KiB. Directory walks\nand final file open never follow symlinks. Every file is regular with expected UID\nand nlink1 (or1/2 only for the reviewed gate/hint publication protocol).\n\"\"\"\nimport os\nimport pwd\nimport json\nimport stat\nimport sys\n\nROOT = '/root/campus1057-gated1329-startup5'\nUSER = '/home/campusqa/campus1057-gated1329-startup5'\nGATE = '/run/campus1057-gated1329-startup5/gate'\nFILES = {\n    'authority': (ROOT + '/evidence/deny-window.json', 'root', (1,)),\n    'stage-ledger': (ROOT + '/evidence/stage-ledger.json', 'root', (1,)),\n    'source-manifest': (ROOT + '/source/gui-sources.json', 'root', (1,)),\n    'root-preflight': (ROOT + '/evidence/root-preflight.json', 'root', (1,)),\n    'desktop': (USER + '/evidence/deny.json', 'user', (1,)),\n    'server': (USER + '/hints/server.jsonl', 'user', (1,)),\n}\nfor name in ('config.json', 'binding.json', 'restored.json', 'release.json'):\n    FILES['gate-' + name] = (GATE + '/' + name, 'root', (1, 2))\n    FILES['gate-pending-' + name] = (GATE + '/.' + name + '.pending', 'root', (1, 2))\nfor name in ('app.json', 'request.json', 'abort.json'):\n    FILES['hint-' + name] = (USER + '/hints/' + name, 'user', (1, 2))\n    FILES['hint-pending-' + name] = (USER + '/hints/.' + name + '.pending', 'user', (1, 2))\n\n\ndef require(ok, message):\n    if not ok:\n        raise RuntimeError(message)\n\n\ndef fingerprint(s):\n    return (s.st_dev, s.st_ino, s.st_mode, s.st_uid, s.st_gid, s.st_nlink,\n            s.st_size, s.st_mtime_ns, s.st_ctime_ns)\n\n\ndef main():\n    require(sys.platform == 'linux' and os.getuid() == os.geteuid() == 0 and\n            sys.flags.isolated and sys.flags.no_site and sys.dont_write_bytecode, 'root -I -S -B')\n    raw = sys.stdin.buffer.read(257)\n    require(len(raw) <= 256, 'input cap')\n    data = json.loads(raw)\n    require(set(data) == {'name'} and data['name'] in FILES, 'fixed owned export key')\n    path, owner, links = FILES[data['name']]\n    uid = pwd.getpwnam('campusqa').pw_uid if owner == 'user' else 0\n    fd = os.open('/', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)\n    try:\n        for part in path.split('/')[1:-1]:\n            following = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)\n            os.close(fd)\n            fd = following\n        name = path.rsplit('/', 1)[1]\n        before = os.stat(name, dir_fd=fd, follow_symlinks=False)\n        require(stat.S_ISREG(before.st_mode) and before.st_uid == uid and\n                before.st_nlink in links and before.st_size <= 131072, 'export file identity/type/bound')\n        stream = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=fd)\n        try:\n            require(fingerprint(os.fstat(stream)) == fingerprint(before), 'export changed before open')\n            raw = bytearray()\n            while True:\n                block = os.read(stream, min(65536, 131073 - len(raw)))\n                if not block:\n                    break\n                raw.extend(block)\n                require(len(raw) <= 131072, 'export grew beyond cap')\n            require(len(raw) == before.st_size and fingerprint(os.fstat(stream)) == fingerprint(before) and\n                    fingerprint(os.stat(name, dir_fd=fd, follow_symlinks=False)) == fingerprint(before),\n                    'export changed while reading')\n        finally:\n            os.close(stream)\n    finally:\n        os.close(fd)\n    sys.stdout.buffer.write(raw)\n    sys.stdout.buffer.flush()\n\n\nif __name__ == '__main__':\n    main()\n"], "returncode": 0, "failure": null, "stdin_bytes": 24, "stdout": "[{\"allocated\": 4096, \"bytes\": 4096, \"device\": 64769, \"event\": \"created-directory\", \"gid\": 0, \"inode\": 1102528, \"mode\": \"0o700\", \"nlink\": 2, \"path\": \"/root/campus1057-gated1329-startup5\", \"uid\": 0}, {\"allocated\": 4096, \"bytes\": 4096, \"device\": 64769, \"event\": \"created-directory\", \"gid\": 0, \"inode\": 1102538, \"mode\": \"0o700\", \"nlink\": 2, \"path\": \"/opt/campus1057-gated1329-startup5\", \"uid\": 0}, {\"allocated\": 0, \"bytes\": 40, \"device\": 27, \"event\": \"created-directory\", \"gid\": 0, \"inode\": 1831, \"mode\": \"0o700\", \"nlink\": 2, \"path\": \"/run/campus1057-gated1329-startup5\", \"uid\": 0}, {\"allocated\": 4096, \"bytes\": 4096, \"device\": 64769, \"event\": \"created-directory\", \"gid\": 0, \"inode\": 1102545, \"mode\": \"0o700\", \"nlink\": 2, \"path\": \"/home/campusqa/campus1057-gated1329-startup5\", \"uid\": 0}, {\"allocated\": 4096, \"bytes\": 4096, \"device\": 64769, \"event\": \"created-directory\", \"gid\": 0, \"inode\": 1102546, \"mode\": \"0o700\", \"nlink\": 2, \"path\": \"/root/campus1057-gated1329-startup5/source\", \"uid\": 0}, {\"allocated\": 4096, \"bytes\": 4096, \"device\": 64769, \"event\": \"created-directory\", \"gid\": 0, \"inode\": 1102547, \"mode\": \"0o700\", \"nlink\": 2, \"path\": \"/root/campus1057-gated1329-startup5/evidence\", \"uid\": 0}, {\"allocated\": 4096, \"bytes\": 4096, \"device\": 64769, \"event\": \"created-directory\", \"gid\": 0, \"inode\": 1102548, \"mode\": \"0o700\", \"nlink\": 2, \"path\": \"/opt/campus1057-gated1329-startup5/source\", \"uid\": 0}, {\"allocated\": 4096, \"bytes\": 4096, \"device\": 64769, \"event\": \"created-directory\", \"gid\": 0, \"inode\": 1102553, \"mode\": \"0o700\", \"nlink\": 2, \"path\": \"/home/campusqa/campus1057-gated1329-startup5/hints\", \"uid\": 0}, {\"allocated\": 4096, \"bytes\": 4096, \"device\": 64769, \"event\": \"created-directory\", \"gid