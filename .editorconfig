# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx,json,yml,yaml,css,html}]
indent_size = 2

[*.{md,markdown}]
indent_size = 2
# Two trailing spaces are a hard line break in Markdown; stripping them
# silently changes rendering.
trim_trailing_whitespace = false

[*.swift]
indent_size = 4

[Makefile]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf
