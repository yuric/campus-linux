    {
      "id": "campus.workflow.transitions",
      "current_revision_id": null,
      "revision": 1,
      "name": "Legal workflow transitions",
      "kind": "transition",
      "origin": "campus",
      "protected": true,
      "enabled": true,
      "trigger": {
        "id": "task_transition_requested",
        "label": "When a task transition is requested",
        "supported": true,
        "authorable": false,
        "state": "Always on",
        "explanation": null
      },
      "project_scope": {
        "mode": "all",
        "project_ids": []
      },
      "conditions": {
        "version": 1,
        "items": []
      },
      "execution_principal": null,
      "execution_profile": {
        "id": "hardened_exact_pr",
        "capability_digest": "sha256:0d35fb53638ae727edefb2afb9dccf40f272a2f9d44852fc5ccf0cf1903d36ec",
        "response_deadline_minutes": 30,
        "team_child_timeout_minutes": 22,
        "team_aggregator_timeout_minutes": 8
      },
      "review_plan": null,
      "activation_required": false,
      "allowed_actions": [],
      "actions": [],
      "summary": "Campus enforces the published task state machine.",
      "source_label": "TaskWorkflow / Task",
      "details": {
        "stages": [
          {
            "id": "imaginarium",
            "transitions": [
              {
                "to": "seashore",
                "workflow_action_ids": [
                  "send_to_seashore"
                ]
              },
              {
                "to": "closed",
                "workflow_action_ids": [
                  "close"
                ]
              }
            ]
          },
          {
            "id": "seashore",
            "transitions": [
              {
                "to": "in_progress",
                "workflow_action_ids": [
                  "start_work"
                ]
              },
              {
                "to": "blocked",
                "workflow_action_ids": [
                  "block_for_review"
                ]
              },
              {
                "to": "imaginarium",
                "workflow_action_ids": [
                  "return_to_ideas",
                  "request_approval"
                ]
              },
              {
                "to": "closed",
                "workflow_action_ids": [
                  "close"
                ]
              }
            ]
          },
          {
            "id": "in_progress",
            "transitions": [
              {
                "to": "blocked",
                "workflow_action_ids": [
                  "block_for_review"
                ]
              },
              {
                "to": "department",
                "workflow_action_ids": []
              },
              {
                "to": "done",
                "workflow_action_ids": [
                  "complete"
                ]
              },
              {
                "to": "closed",
                "workflow_action_ids": [
                  "close"
                ]
              }
            ]
          },
          {
            "id": "department",
            "transitions": [
              {
                "to": "in_progress",
                "workflow_action_ids": [
                  "resume"
                ]
              },
              {
                "to": "blocked",
                "workflow_action_ids": []
              },
              {
                "to": "closed",
                "workflow_action_ids": [
                  "close"
                ]
              }
            ]
          },
          {
            "id": "blocked",
            "transitions": [
              {
                "to": "in_progress",
                "workflow_action_ids": [
                  "unblock",
                  "reassign"
                ]
              },
              {
                "to": "seashore",
                "workflow_action_ids": [
                  "return_to_ready"
                ]
              },
              {
                "to": "imaginarium",
                "workflow_action_ids": [
                  "return_to_ideas",
                  "request_approval"
                ]
              },
              {
                "to": "closed",
                "workflow_action_ids": [
                  "close"
                ]
              }
            ]
          },
          {
            "id": "done",
            "transitions": [
              {
                "to": "imaginarium",
                "workflow_action_ids": [
                  "reopen"
                ]
              }
            ]
          },
          {
            "id": "closed",
            "transitions": [
              {
                "to": "imaginarium",
                "workflow_action_ids": [
                  "reopen"
                ]
              }
            ]
          }
        ],
        "labels": {
          "imaginarium": "Imaginarium",
          "approval": "Awaiting your approval",
          "blocked": "Blocked",
          "seashore": "Ready",
          "in_progress": "In progress",
          "done": "Done"
        }
      },
      "status": {
        "id": "always_on",
        "label": "Always on",
        "severity": "message"
      },
      "lock": {
        "locked": true,
        "label": "Campus default",
        "explanation": "Campus owns this behavior and it cannot be edited."
      },
      "archived": false
    },
